{
	"name": "racemake-hard",
	"scripts": {
		"dev": "concurrently --kill-others --names api,web --prefix-colors blue,green \"bun run dev:api\" \"bun run dev:web\"",
		"dev:api": "bun run --hot src/index.ts",
		"dev:web": "vite",
		"build": "vite build",
		"start": "bun run src/index.ts",
		"typecheck": "bunx tsc --noEmit && bunx tsc -p frontend/tsconfig.json --noEmit",
		"lint": "bunx @biomejs/biome lint .",
		"analyze:data": "bun scripts/analyze-data.ts",
		"generate:spa-data": "bun scripts/generate-spa-dataset.ts",
		"generate:limited-data": "bun scripts/generate-limited-stint-dataset.ts",
		"generate:low-confidence-finish-data": "bun scripts/generate-low-confidence-finish-dataset.ts",
		"generate:start-finish-gap-data": "bun scripts/generate-start-finish-gap-dataset.ts",
		"generate:single-lap-data": "bun scripts/generate-single-racing-lap-dataset.ts",
		"test:data-audit": "bun test tests/integration/data-audit-pipeline.test.ts"
	},
	"dependencies": {
		"@phosphor-icons/react": "^2.1.10",
		"@tanstack/react-query": "^5.101.4",
		"echarts": "^6.1.0",
		"hono": "^4.13.4",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-router-dom": "^7.18.2",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "latest",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.0.5",
		"concurrently": "^10.0.4",
		"tailwindcss": "^4.3.3",
		"vite": "^8.2.1"
	}
}
